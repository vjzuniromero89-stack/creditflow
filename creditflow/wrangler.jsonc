{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "creditflow",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "creditflow-db",
      "database_id": "aefef337-44cd-4328-aec0-2bf9fa91b63f"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
